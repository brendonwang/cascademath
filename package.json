{
  "name": "cascade-math-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .server-build && node scripts/prerender.mjs",
    "build:production": "node scripts/validate-production.mjs && pnpm build && node scripts/verify-deployment.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev --config wrangler.jsonc",
    "deploy:dry-run": "pnpm build:production && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "pnpm build:production && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.125.0"
  }
}
