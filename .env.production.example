# Use the final HTTPS origin with no trailing slash.
VITE_SITE_URL=https://www.example.org
# Public Turnstile sitekey for the production widget.
VITE_TURNSTILE_SITE_KEY=replace-with-your-turnstile-sitekey
# Public token copied from Cloudflare Web Analytics > Manage site.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=replace-with-your-cloudflare-analytics-token
